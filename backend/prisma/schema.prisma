generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  latitude  Float
  longitude Float
  createdAt DateTime  @default(now())
  weather   Weather[]
}

model Weather {
  id           Int      @id @default(autoincrement())
  cityId       Int
  temperature  Float
  windSpeed    Float
  weatherCode  Int
  isDay        Boolean
  fetchedAt    DateTime
  externalError Boolean  @default(false)
  city         City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId, fetchedAt(sort: Desc)])
}
